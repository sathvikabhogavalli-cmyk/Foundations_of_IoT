--cpu=Cortex-M4.fp.sp
"http_server\startup_stm32f401xe.o"
"http_server\main.o"
"http_server\stm32f4xx_it.o"
"http_server\stm32f4xx_hal_msp.o"
"http_server\stm32f4xx_hal_uart.o"
"http_server\stm32f4xx_hal_rcc.o"
"http_server\stm32f4xx_hal_rcc_ex.o"
"http_server\stm32f4xx_hal_flash.o"
"http_server\stm32f4xx_hal_flash_ex.o"
"http_server\stm32f4xx_hal_flash_ramfunc.o"
"http_server\stm32f4xx_hal_gpio.o"
"http_server\stm32f4xx_hal_dma_ex.o"
"http_server\stm32f4xx_hal_dma.o"
"http_server\stm32f4xx_hal_pwr.o"
"http_server\stm32f4xx_hal_pwr_ex.o"
