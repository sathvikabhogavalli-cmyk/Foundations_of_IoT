--cpu=Cortex-M4.fp.sp
"mqtt\startup_stm32f401xe.o"
"mqtt\esplib.o"
"mqtt\main.o"
"mqtt\stm32f4xx_it.o"
"mqtt\stm32f4xx_hal_msp.o"
"mqtt\stm32f4xx_hal_i2c.o"
"mqtt\stm32f4xx_hal_i2c_ex.o"
"mqtt\stm32f4xx_hal_rcc.o"
"mqtt\stm32f4xx_hal_rcc_ex.o"
"mqtt\stm32f4xx_hal_flash.o"
"mqtt\stm32f4xx_hal_flash_ex.o"
"mqtt\stm32f4xx_hal_flash_ramfunc.o"
"mqtt\stm32f4xx_hal_gpio.o"
"mqtt\stm32f4xx_hal_dma_ex.o"
"mqtt\stm32f4xx_hal_dma.o"
"mqtt\stm32f4xx_hal_pwr.o"
"mqtt\stm32f4xx_hal_pwr_ex.o"
"mqtt\stm32f4xx_hal_cortex.o"
"mqtt\stm32f4xx_hal.o"
"mqtt\stm32f4xx_hal_exti.o"
"mqtt\stm32f4xx_hal_uart.o"
"mqtt\system_stm32f4xx.o"
--strict --scatter "MQTT\MQTT.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "MQTT.map" -o MQTT\MQTT.axf